[req]
default_bits = 2048
prompt = no
default_md = sha256
x509_extensions = v3
distinguished_name = dn
[dn]
C = CN
ST = Test
L = Test
O = class_score test fixture
CN = 127.0.0.1
[v3]
subjectAltName = @alt
basicConstraints = critical,CA:TRUE
keyUsage = critical,digitalSignature,keyEncipherment,keyCertSign
[alt]
IP.1 = 127.0.0.1
DNS.1 = localhost
